<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Filee.App.ViewModels.Pages"
             x:Class="Filee.App.Views.Pages.BatchRenamePage"
             x:DataType="vm:BatchRenamePageViewModel">
  <UserControl.Styles>
    <Style Selector="Border#RenameDrop.over">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Background" Value="{DynamicResource AccentFaintBrush}"/>
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="18">
    <StackPanel Spacing="5">
      <TextBlock Classes="h1" Text="{DynamicResource batch.title}"/>
      <TextBlock Classes="muted" Text="{DynamicResource batch.intro}" TextWrapping="Wrap"/>
    </StackPanel>

    <Border x:Name="RenameDrop" BorderBrush="{DynamicResource SubtleBorderBrush}"
            BorderThickness="1" CornerRadius="12" Background="{DynamicResource SurfaceBrush}"
            Padding="18" MinHeight="150" Cursor="Hand" DragDrop.AllowDrop="True"
            ToolTip.Tip="{DynamicResource batch.drop_hint}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
        <PathIcon Data="{StaticResource Icon.Upload}" Width="28" Height="28"
                  Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
        <TextBlock Text="{DynamicResource batch.drop}" FontWeight="SemiBold" FontSize="16"
                   HorizontalAlignment="Center" TextAlignment="Center"/>
        <TextBlock Text="{DynamicResource batch.drop_hint}" Classes="caption"
                   HorizontalAlignment="Center" TextAlignment="Center"/>
      </StackPanel>
    </Border>

    <StackPanel Spacing="14" IsVisible="{Binding HasFiles}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="{DynamicResource batch.add}" Click="OnPickFiles" IsEnabled="{Binding !Busy}"/>
          <Button x:Name="ClearBatchSelectionButton" Content="{DynamicResource batch.clear}" Command="{Binding ClearCommand}" IsEnabled="{Binding CanClear}"/>
        </StackPanel>
        <TextBlock Text="{Binding FileCountText}" Classes="label" VerticalAlignment="Center"/>
      </DockPanel>

      <Border Classes="card" Padding="16">
        <StackPanel Spacing="13" IsEnabled="{Binding !Busy}">
          <StackPanel Spacing="5">
            <TextBlock Classes="label" Text="{DynamicResource batch.base_name}"/>
            <TextBox Text="{Binding BaseName}" PlaceholderText="{DynamicResource batch.base_name}"
                     IsEnabled="{Binding !UseOriginalNames}"/>
          </StackPanel>
          <Grid ColumnDefinitions="*,16,*">
            <StackPanel Spacing="5">
              <TextBlock Classes="label" Text="{DynamicResource batch.first_number}"/>
              <TextBox Text="{Binding FirstNumber}" PlaceholderText="1" IsEnabled="{Binding AddNumbers}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="5">
              <TextBlock Classes="label" Text="{DynamicResource batch.separator}"/>
              <ComboBox ItemsSource="{Binding SeparatorChoices}" SelectedItem="{Binding SelectedSeparator}"
                        HorizontalAlignment="Stretch" IsEnabled="{Binding AddNumbers}"/>
            </StackPanel>
          </Grid>
          <Expander Header="{DynamicResource batch.advanced}" IsExpanded="False">
            <StackPanel Spacing="10" Margin="12,8,12,12">
              <CheckBox Content="{DynamicResource batch.use_original_names}" IsChecked="{Binding UseOriginalNames}"/>
              <CheckBox Content="{DynamicResource batch.numbering}" IsChecked="{Binding AddNumbers}"/>
              <Grid ColumnDefinitions="*,12,*">
                <StackPanel Spacing="4">
                  <TextBlock Classes="label" Text="{DynamicResource batch.find}"/>
                  <TextBox Text="{Binding FindText}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                  <TextBlock Classes="label" Text="{DynamicResource batch.replace}"/>
                  <TextBox Text="{Binding ReplaceText}"/>
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,12,*">
                <StackPanel Spacing="4">
                  <TextBlock Classes="label" Text="{DynamicResource batch.prefix}"/>
                  <TextBox Text="{Binding Prefix}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                  <TextBlock Classes="label" Text="{DynamicResource batch.suffix}"/>
                  <TextBox Text="{Binding Suffix}"/>
                </StackPanel>
              </Grid>
              <TextBlock Classes="label" Text="{DynamicResource batch.case}"/>
              <ComboBox ItemsSource="{Binding LetterCaseChoices}" SelectedItem="{Binding SelectedLetterCase}"
                        HorizontalAlignment="Stretch"/>
            </StackPanel>
          </Expander>
          <StackPanel Spacing="5">
            <TextBlock Classes="label" Text="{DynamicResource batch.format}"/>
            <ComboBox ItemsSource="{Binding FormatChoices}" SelectedItem="{Binding SelectedFormat}"
                      IsEnabled="{Binding !Busy}" HorizontalAlignment="Stretch"/>
            <TextBlock Classes="caption" Text="{DynamicResource batch.format_hint}" TextWrapping="Wrap"/>
          </StackPanel>
          <CheckBox Content="{DynamicResource batch.delete_originals}" IsChecked="{Binding DeleteOriginals}"
                    IsEnabled="{Binding CanDeleteOriginals}"/>
          <TextBlock Classes="caption" Text="{DynamicResource batch.trash_hint}"
                     TextWrapping="Wrap" IsVisible="{Binding IsConversion}"/>
          <StackPanel Spacing="5">
            <TextBlock Classes="label" Text="{DynamicResource batch.destination}"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="{DynamicResource batch.browse}"
                      Click="OnPickDestination" IsEnabled="{Binding !Busy}" Margin="8,0,0,0"/>
              <Button DockPanel.Dock="Right" Content="{DynamicResource batch.source_folders}"
                      Command="{Binding ClearDestinationCommand}" IsEnabled="{Binding HasDestination}"
                      Margin="8,0,0,0"/>
              <TextBox Text="{Binding DestinationFolder}" PlaceholderText="{DynamicResource batch.optional_folder}"
                       IsEnabled="{Binding !Busy}"/>
            </DockPanel>
            <TextBlock Classes="caption" Text="{Binding DestinationDescription}" TextWrapping="Wrap"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <StackPanel Spacing="10">
        <TextBlock Classes="label" Text="{DynamicResource batch.preview}"/>
        <Border Classes="card" Padding="12">
          <StackPanel Spacing="8">
            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Preview}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BatchRenamePreviewRow">
                    <Border Padding="4,7" BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource SubtleBorderBrush}">
                      <DockPanel>
                        <!-- Only removes the entry from this batch, never the source file on disk. -->
                        <Button DockPanel.Dock="Right" Classes="ghost" Width="32" Height="32"
                                Padding="5" Margin="8,0,0,0"
                                Click="OnRemoveFile" Tag="{Binding Source}"
                                ToolTip.Tip="{DynamicResource batch.remove_file}"
                                AutomationProperties.Name="{DynamicResource batch.remove_file}">
                          <PathIcon Data="{StaticResource Icon.Delete}" Width="16" Height="16"/>
                        </Button>
                        <PathIcon DockPanel.Dock="Right" Width="15" Height="15"
                                  Data="{StaticResource Icon.Check}" Foreground="{DynamicResource SuccessBrush}"
                                  IsVisible="{Binding IsValid}" Margin="8,0,0,0"/>
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding OldName}" Classes="caption" TextDecorations="Strikethrough"
                                     TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding NewName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Target}"/>
                          <TextBlock Text="{Binding Error}" Classes="caption danger" TextWrapping="Wrap" IsVisible="{Binding !IsValid}"/>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>
      </StackPanel>

      <ProgressBar Minimum="0" Maximum="{Binding FileCount}" Value="{Binding CompletedCount}"
                   IsVisible="{Binding Busy}"/>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Classes="caption"/>
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="{DynamicResource batch.undo}" Command="{Binding UndoCommand}"
                  ToolTip.Tip="{DynamicResource batch.undo_tooltip}"
                  IsVisible="{Binding CanUndo}" IsEnabled="{Binding !Busy}"/>
          <Button Content="{DynamicResource batch.cancel}" Command="{Binding CancelCommand}"
                  IsVisible="{Binding Busy}"/>
          <Button Classes="accent" Content="{DynamicResource batch.run}" Command="{Binding RunCommand}"
                  IsEnabled="{Binding CanRun}"/>
        </StackPanel>
        <TextBlock Text="{DynamicResource batch.safety_hint}" Classes="caption"
                   TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="320"/>
      </DockPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
