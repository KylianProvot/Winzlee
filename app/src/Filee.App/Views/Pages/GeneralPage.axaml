<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Filee.App.ViewModels.Pages"
             x:Class="Filee.App.Views.Pages.GeneralPage"
             x:DataType="vm:GeneralPageViewModel">
  <StackPanel Spacing="20">
    <StackPanel Spacing="7">
      <TextBlock Classes="h1" Text="{DynamicResource general.title}" />
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="{DynamicResource dashboard.settings_intro}"/>
    </StackPanel>

    <TextBlock Classes="winzlee-group-title" Text="{DynamicResource dashboard.settings_app}"/>
    <Border Classes="card">
      <StackPanel Spacing="14">
        <StackPanel>
          <TextBlock Classes="label" Text="{DynamicResource general.language}" />
          <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" MinWidth="240" AutomationProperties.Name="{DynamicResource general.language}" />
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="{DynamicResource winzlee.appearance}" />
          <ComboBox x:Name="WinzleeThemeChoice" ItemsSource="{Binding AppearanceChoices}"
                    SelectedItem="{Binding AppearanceChoice}" MinWidth="240"
                    AutomationProperties.Name="{DynamicResource winzlee.appearance}"
                    HorizontalAlignment="Left" />
          <TextBlock Classes="caption" Text="{DynamicResource winzlee.appearance_hint}" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Spacing="5" IsVisible="{Binding IsWindows}">
          <ToggleSwitch x:Name="WinzleeStartWithWindowsSwitch"
                        Content="{DynamicResource general.start_with_system}" IsChecked="{Binding StartWithSystem}" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource winzlee.startup_hint}" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding StartupStatus}"
                     IsVisible="{Binding StartupStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource shell.integration_pending}"
                   IsVisible="{Binding !HasSystemIntegration}" />
        <ToggleSwitch x:Name="ShowInDockSwitch" Content="{DynamicResource general.show_in_dock}"
                      IsChecked="{Binding ShowInDock}" IsVisible="{Binding SupportsDockVisibility}" />
        <ToggleSwitch x:Name="ShowMenuBarIconSwitch" Content="{DynamicResource general.show_menu_bar_icon}"
                      IsChecked="{Binding ShowMenuBarIcon}" IsVisible="{Binding SupportsDockVisibility}" />
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding DockStatus}"
                   IsVisible="{Binding DockStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <StackPanel>
          <TextBlock Classes="label" Text="{DynamicResource general.close_action}" />
          <ComboBox ItemsSource="{Binding CloseChoices}" SelectedItem="{Binding CloseChoice}" MinWidth="240" AutomationProperties.Name="{DynamicResource general.close_action}" />
        </StackPanel>
        <ToggleSwitch Content="{Binding ContextMenuText}" IsChecked="{Binding ContextMenu}" IsVisible="{Binding HasSystemIntegration}" />
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding IntegrationMessage}"
                   IsVisible="{Binding IntegrationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <!-- Windows 11: optional top-level entry (needs one administrator prompt), see ExplorerMenuRegistration. -->
        <StackPanel Spacing="8" IsVisible="{Binding ShowModernMenu}">
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding ModernMenuStatus}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{DynamicResource general.modern_menu_add}" Command="{Binding AddModernMenuCommand}" IsVisible="{Binding CanAddModernMenu}" />
            <Button Content="{DynamicResource general.modern_menu_remove}" Command="{Binding RemoveModernMenuCommand}" IsVisible="{Binding CanRemoveModernMenu}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Conversion and browser sources, regrouped for easier scanning. -->
    <TextBlock Classes="winzlee-group-title" Text="{DynamicResource dashboard.settings_files}"/>
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="{DynamicResource general.default_output}" />
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource general.default_output_hint}" />
        <ComboBox ItemsSource="{Binding OutputLocations}" SelectedItem="{Binding DefaultLocation}" MinWidth="240" AutomationProperties.Name="{DynamicResource general.default_output}" />
        <StackPanel IsVisible="{Binding ShowDefaultSubfolder}">
          <TextBlock Classes="label" Text="{DynamicResource presets.subfolder}" />
          <TextBox Text="{Binding DefaultSubfolder}" PlaceholderText="converted" MaxWidth="420" HorizontalAlignment="Left" MinWidth="240"
                   AutomationProperties.Name="{DynamicResource presets.subfolder}" />
        </StackPanel>
        <StackPanel IsVisible="{Binding ShowDefaultFolder}">
          <TextBlock Classes="label" Text="{DynamicResource presets.custom_folder}" />
          <DockPanel MaxWidth="560" HorizontalAlignment="Stretch">
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{DynamicResource presets.browse}" Click="OnBrowseDefaultFolder" />
            <TextBox Text="{Binding DefaultFolder}" AutomationProperties.Name="{DynamicResource presets.custom_folder}" />
          </DockPanel>
        </StackPanel>
        <ToggleSwitch Content="{DynamicResource general.keep_dates}" IsChecked="{Binding KeepFileDates}" />
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource general.keep_dates_hint}" Margin="0,-6,0,0" />
        <ToggleSwitch Content="{DynamicResource general.zip_geo}" IsChecked="{Binding ZipGeoResults}" />
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource general.zip_geo_hint}" Margin="0,-6,0,0" />
      </StackPanel>
    </Border>

    <!-- Pictures, links and downloads dragged out of a web browser (AppSettings.BrowserDrops). -->
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="{DynamicResource general.browser_drops}" />
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource general.browser_drops_hint}" />
        <StackPanel>
          <TextBlock Classes="label" Text="{DynamicResource general.browser_drops_folder}" />
          <DockPanel HorizontalAlignment="Left">
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{DynamicResource presets.browse}" Click="OnBrowseBrowserFolder" />
            <TextBox Text="{Binding BrowserFolder}" PlaceholderText="{Binding DownloadsFolder}" Width="440" />
          </DockPanel>
        </StackPanel>
        <CheckBox Content="{DynamicResource general.browser_drops_only_converted}" IsChecked="{Binding SaveOnlyConverted}" />
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource general.browser_drops_only_converted_hint}" Margin="0,-6,0,0" />
      </StackPanel>
    </Border>

    <TextBlock Classes="winzlee-group-title" Text="{DynamicResource dashboard.settings_data}"/>
    <Border Classes="card">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="{DynamicResource general.history}" />
        <ToggleSwitch Content="{DynamicResource general.no_history}" IsChecked="{Binding NoHistory}" />
        <StackPanel IsVisible="{Binding !NoHistory}">
          <TextBlock Classes="label" Text="{DynamicResource general.history_limit}" />
          <NumericUpDown Value="{Binding HistoryLimit}" Minimum="50" Maximum="2000" Increment="50" FormatString="0"
                         HorizontalAlignment="Left" MinWidth="160" AutomationProperties.Name="{DynamicResource general.history_limit}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="{DynamicResource general.clear_history}" Command="{Binding ClearHistoryCommand}" />
          <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding HistoryText}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="{DynamicResource general.library}" />
        <WrapPanel>
          <Button Content="{DynamicResource general.export}" Click="OnExport" Margin="0,0,8,8" />
          <Button Content="{DynamicResource general.import}" Click="OnImport" Margin="0,0,8,8" />
          <Button Content="{DynamicResource general.reset_library}" Click="OnReset" Margin="0,0,8,8" />
        </WrapPanel>
        <TextBlock Classes="muted" Text="{Binding LibraryMessage}" />
      </StackPanel>
    </Border>

    <Border Classes="card">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{DynamicResource general.open_data_folder}" Command="{Binding OpenDataFolderCommand}" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Classes="label" Text="{DynamicResource general.data_folder}" />
          <TextBlock Text="{Binding DataFolder}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </DockPanel>
    </Border>
    <!-- Optional local diagnostic; no changes to personal files. -->
    <Expander x:Name="WinzleeDiagnosticsExpander" Header="{DynamicResource winzlee.diagnostics.title}" IsExpanded="False">
      <Border Classes="card" Padding="14" Margin="0,8,0,0">
        <StackPanel Spacing="10">
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{DynamicResource winzlee.diagnostics.description}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="RunWinzleeDiagnosticsButton" Command="{Binding RunDiagnosticsCommand}"
                    Content="{DynamicResource winzlee.diagnostics.run}" />
            <Button x:Name="CopyWinzleeDiagnosticsButton" Click="OnCopyDiagnostics"
                    Content="{DynamicResource winzlee.diagnostics.copy}" IsEnabled="{Binding HasDiagnosticsReport}" />
          </StackPanel>
          <TextBox x:Name="WinzleeDiagnosticsOutput" Text="{Binding DiagnosticsReport, Mode=OneWay}"
                   IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="125"
                   IsVisible="{Binding HasDiagnosticsReport}" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding DiagnosticsCopyStatus}" />
        </StackPanel>
      </Border>
    </Expander>

    <TextBlock Classes="winzlee-group-title" Text="{DynamicResource winzlee.advanced}" />
    <TextBlock Classes="muted" Text="{DynamicResource winzlee.advanced_hint}" TextWrapping="Wrap"/>

    <!-- Advanced tools stay available, but no longer clutter the main menu. -->
    <Expander x:Name="WatchSettingsExpander" IsExpanded="{Binding ShowWatchSettings}"
              Header="{DynamicResource winzlee.watch_heading}">
      <Border Classes="card" Padding="14" Margin="0,10,0,6">
        <ContentControl Content="{Binding WatchSettingsPage}" />
      </Border>
    </Expander>
    <Expander x:Name="EnginesSettingsExpander" IsExpanded="{Binding ShowEnginesSettings}"
              Header="{DynamicResource winzlee.engines_heading}">
      <StackPanel Spacing="12" Margin="0,10,0,6">
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{DynamicResource winzlee.engines_simple}"/>
        <Expander x:Name="EnginesTechnicalExpander" Header="{DynamicResource winzlee.engines_technical}" IsExpanded="False">
          <Border Classes="card" Padding="14" Margin="0,8,0,0">
            <ContentControl Content="{Binding EnginesSettingsPage}" />
          </Border>
        </Expander>
      </StackPanel>
    </Expander>
  </StackPanel>
</UserControl>
